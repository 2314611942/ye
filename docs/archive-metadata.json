          "Categories": {
            "value": "Ye Ting|PD US|PD China|Edgar Snow|Images with extracted images|Template Unknown (author)|1938 in Hankou|1938 black and white photographs in Wuhan",
            "source": "commons-categories",
            "hidden": ""
