[
  {
    "start": 26.78,
    "end": 29.54,
    "text": "烽火燃遍华夏疆土"
  },
  {
    "start": 29.8,
    "end": 32.4,
    "text": "铁肩扛起家国荣辱"
  },
  {
    "start": 33.14,
    "end": 35.62,
    "text": "北伐路上战旗飞舞"
  },
  {
    "start": 36.14,
    "end": 38.56,
    "text": "一腔热血不惧险阻"
  },
  {
    "start": 39.12,
    "end": 41.62,
    "text": "山河破碎风雨凄苦"
  },
  {
    "start": 42.14,
    "end": 44.54,
    "text": "丹心向着光明归宿"
  },
  {
    "start": 45.1,
    "end": 47.76,
    "text": "铮铮铁骨傲然如故"
  },
  {
    "start": 47.88,
    "end": 50.66,
    "text": "初心不改不负故土"
  },
  {
    "start": 52.48,
    "end": 56.66,
    "text": "啊 叶挺将军 铁军风骨"
  },
  {
    "start": 56.86,
    "end": 59.58,
    "text": "赤胆忠心 照亮征途"
  },
  {
    "start": 60.12,
    "end": 62.56,
    "text": "宁为玉碎 绝不屈服"
  },
  {
    "start": 63.12,
    "end": 65.18,
    "text": "革命理想 永垂千古"
  },
  {
    "start": 65.84,
    "end": 68.56,
    "text": "啊 叶挺将军 浩气永驻"
  },
  {
    "start": 69.12,
    "end": 71.64,
    "text": "一腔赤诚 守护国土"
  },
  {
    "start": 72.14,
    "end": 74.58,
    "text": "烽火岁月 壮志如初"
  },
  {
    "start": 74.98,
    "end": 79.14,
    "text": "红色精神 代代传承"
  },
  {
    "start": 80.54,
    "end": 83.56,
    "text": "囚室难锁凌云抱负"
  },
  {
    "start": 84.1,
    "end": 86.56,
    "text": "烈火炼就英雄风骨"
  },
  {
    "start": 87.12,
    "end": 89.56,
    "text": "《囚歌》一曲响彻千古"
  },
  {
    "start": 90.1,
    "end": 92.58,
    "text": "气节凛然气贯寰宇"
  },
  {
    "start": 93.12,
    "end": 95.72,
    "text": "山河期盼黎明光束"
  },
  {
    "start": 95.8,
    "end": 98.62,
    "text": "壮志未酬信念如故"
  },
  {
    "start": 98.86,
    "end": 101.62,
    "text": "一身肝胆天地共睹"
  },
  {
    "start": 102.12,
    "end": 104.62,
    "text": "热血铸就不朽丰碑"
  },
  {
    "start": 107.76,
    "end": 110.56,
    "text": "啊 叶挺将军 铁军风骨"
  },
  {
    "start": 111.14,
    "end": 113.58,
    "text": "赤胆忠心 照亮征途"
  },
  {
    "start": 114.12,
    "end": 116.54,
    "text": "宁为玉碎 绝不屈服"
  },
  {
    "start": 117.26,
    "end": 119.3,
    "text": "革命理想 永垂千古"
  },
  {
    "start": 119.46,
    "end": 122.58,
    "text": "啊 叶挺将军 浩气永驻"
  },
  {
    "start": 123.1,
    "end": 125.6,
    "text": "一腔赤诚 守护国土"
  },
  {
    "start": 126.12,
    "end": 128.56,
    "text": "烽火岁月 壮志如初"
  },
  {
    "start": 129.12,
    "end": 132.88,
    "text": "红色精神 代代传承"
  },
  {
    "start": 134.38,
    "end": 140.68,
    "text": "铁军精神 万古流芳"
  },
  {
    "start": 141.5,
    "end": 147.82,
    "text": "英雄气节 永世难忘"
  }
